# Template for EC2 deploys (`npm run deploy:ec2`). Safe to commit — placeholders only.
# Copy: cp .env.deploy.example .env.deploy   (.env.deploy is gitignored; real values go there)

# SSH into the box that hosts performance.nextventures.io, e.g. ubuntu@<ec2-ip>
PERF_EC2_HOST=

# Absolute path to your SSH private key, e.g. $HOME/keys/<key-name>.pem
PERF_EC2_PEM=

# Where nginx serves https://performance.nextventures.io/platform/
# PERF_PLATFORM_WEB_DIR=/var/www/platform

# Optional API origin for local/dev builds only (empty = same-origin /api)
# VITE_API_BASE_URL=
