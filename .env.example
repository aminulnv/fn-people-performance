# Runtime (optional). Empty = browser calls same-origin /api on performance.nextventures.io
VITE_API_BASE_URL=

# Local Vite proxy target for /api (default: production host). Prefer empty + proxy.
# VITE_API_PROXY_TARGET=https://performance.nextventures.io

# Auth on localhost:
# - Default: real Google via Vite /api proxy. Requires the localhost callback in
#   Google Console and a deployed platform API that honors X-Forwarded-Host.
# - VITE_AUTH_MODE=local → sessionStorage only (no Google / no live cookie).
# VITE_AUTH_MODE=

# Force in-memory employees (tests use MODE=test automatically).
# VITE_EMPLOYEES_BACKEND=local

# For shipping to EC2 /platform, use .env.deploy (see .env.deploy.example) — not this file.
# Vite never needs DB_* or Google secrets.
#
# Platform Google OAuth lives on the API server .env (never dashboard GOOGLE_*):
#   PLATFORM_GOOGLE_CLIENT_ID=
#   PLATFORM_GOOGLE_CLIENT_SECRET=
#   PLATFORM_ALLOWED_EMAIL_DOMAIN=nextventures.io   # optional
#   PLATFORM_DEFAULT_PASSWORD=                       # temporary email login; set on server only
#   PLATFORM_SESSION_SECRET=                         # optional; falls back to SESSION_SECRET
# Redirect URI to add in that Google Cloud project:
#   https://performance.nextventures.io/api/platform/auth/google/callback
