# Copy these into the API host .env on EC2 (next-performance/.env).
# Never commit real values. Never reuse the dashboard GOOGLE_CLIENT_* keys.

PLATFORM_GOOGLE_CLIENT_ID=
PLATFORM_GOOGLE_CLIENT_SECRET=

# Optional overrides
# PLATFORM_ALLOWED_EMAIL_DOMAIN=nextventures.io
# PLATFORM_SESSION_SECRET=

# Google Cloud Console → OAuth client → Authorized redirect URIs:
# https://performance.nextventures.io/api/platform/auth/google/callback
# http://localhost:8001/api/platform/auth/google/callback
