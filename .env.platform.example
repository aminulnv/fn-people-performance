# Copy into next-performance/.env on EC2 (still used by platform-api deploy to seed its own .env).
# Never commit real values. Never reuse the dashboard GOOGLE_CLIENT_* keys.
#
# Platform API runs as its own Docker service (:3002). Dashboard rebuilds do not wipe it.
# Deploy with: npm run deploy:platform-api

PLATFORM_GOOGLE_CLIENT_ID=
PLATFORM_GOOGLE_CLIENT_SECRET=

# Platform API database role (DML on platform.* only). Set these on the EC2
# dashboard .env via scripts/provision-platform-db-role.sh - deploy:platform-api
# then uses them instead of the shared dashboard DB_USERNAME / DB_PASS.
# PLATFORM_DB_USERNAME=platform_app
# PLATFORM_DB_PASS=

# Optional overrides
# PLATFORM_ALLOWED_EMAIL_DOMAIN=nextventures.io
# PLATFORM_DEFAULT_PASSWORD=
# The API refuses to start unless one of these is set.
# PLATFORM_SESSION_SECRET=
# SESSION_SECRET=
# Comma-separated emails allowed to assign the first Admin · Read + write access.
# Remove after at least one persistent read+write admin has been assigned.
PLATFORM_BOOTSTRAP_ADMIN_EMAILS=aminul.islam@nextventures.io

# OKR platform machine-to-machine key. Server only - never VITE_* or client code.
# PERFORMANCE_OKR_API_KEY=
# PERFORMANCE_OKR_API_URL=https://okr.nextventures.io

# --- Notification outbound channels ---
# Same title/body as in-app. Leave blank during testing so nothing hits inboxes.
# When you are ready: fill SMTP (and optionally ClickUp), restart platform-api.
# Rows created while unset are stored as not_configured (no catch-up flood later).

# PLATFORM_APP_BASE_URL=https://performance.nextventures.io/platform
# PLATFORM_SMTP_HOST=
# PLATFORM_SMTP_PORT=587
# PLATFORM_SMTP_SECURE=false
# PLATFORM_SMTP_USER=
# PLATFORM_SMTP_PASS=

# How often the API checks stage schedules (publish auto-release, manager
# force-move, calibration lock). Goal day-7/14/25 reminders still run once/day.
# PLATFORM_CYCLE_SCHEDULER_INTERVAL_MS=60000
# PLATFORM_SMTP_FROM="People Performance <noreply@nextventures.io>"
# Optional hard off even when SMTP is set (staging with real creds):
# PLATFORM_EMAIL_DELIVERY_ENABLED=false

# ClickUp (later). Creates a task on the list with the notification copy.
# PLATFORM_CLICKUP_API_TOKEN=
# PLATFORM_CLICKUP_LIST_ID=
# PLATFORM_CLICKUP_API_BASE=https://api.clickup.com/api/v2
# PLATFORM_CLICKUP_DELIVERY_ENABLED=false

# Outbox poller interval (ms). Default 15000.
# PLATFORM_NOTIFICATION_DELIVERY_INTERVAL_MS=15000

# Google Cloud Console → OAuth client → Authorized redirect URIs:
# https://performance.nextventures.io/api/platform/auth/google/callback
# http://localhost:8001/api/platform/auth/google/callback
